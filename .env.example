# Postgres. Local: createdb tec_admin
DATABASE_URL="postgresql://postgres@localhost:5432/tec_admin"

# Signing key for admin session tokens. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-before-deploying"

# How long an admin stays signed in.
AUTH_TOKEN_TTL="12h"

# Fallback only. The live value lives in the Setting table (A10 · Settings)
# and is editable from the admin panel.
QUIZ_TIMEZONE="America/New_York"

# Origins allowed to call this API. Comma separated, or * in development.
# The browser calls this API directly, so the admin panel origin MUST be listed
# here or the login request is blocked by CORS.
ALLOWED_ORIGINS="http://localhost:4000,http://localhost:5500"

# Session cookie scope. Leave both blank in development: ports are not part of
# a cookie's identity, so a cookie set by localhost:4001 is already sent to the
# panel on localhost:4000.
#
# In production the panel and the API sit on different hostnames, so the cookie
# must be widened to the shared parent domain or the panel will never see it:
#   SESSION_COOKIE_DOMAIN=".esticonfidential.com"
#   SESSION_COOKIE_SAMESITE="None"      # requires HTTPS
# Two unrelated hosts (for example *.onrender.com) cannot share a cookie at all —
# put both behind one domain before going live.
SESSION_COOKIE_DOMAIN=""
SESSION_COOKIE_SAMESITE="Lax"

# Origins allowed to call the member quiz endpoints (/api/quiz/*). These send no
# cookie, so a wildcard is safe and is the default. Narrow it to the quiz's own
# origin once the Circle surface is settled, e.g.
#   QUIZ_ALLOWED_ORIGINS="https://esti-community.netlify.app"
QUIZ_ALLOWED_ORIGINS="*"

# Where the member quiz is hosted. Seeded into Settings, which is what builds
# the Circle embed snippet. Locally that is the admin panel's own /quiz route.
SEED_QUIZ_EMBED_URL="http://localhost:4000/quiz"

# Seed credentials for the administrator account (npm run db:seed).
# Development only — change the password before this goes anywhere public.
SEED_ADMIN_EMAIL="adam@esticonfidential.com"
SEED_ADMIN_NAME="Adam Ross"
SEED_ADMIN_PASSWORD="Admin@123"
